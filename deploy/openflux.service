[Unit]
Description=OpenFlux encrypted exit node (l3, Session: direct + Yandex)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/openflux/etc
ExecStartPre=/bin/sh -c '/usr/sbin/iptables -C OUTPUT -p tcp --tcp-flags RST RST -j DROP 2>/dev/null || /usr/sbin/iptables -I OUTPUT 1 -p tcp --tcp-flags RST RST -j DROP'
ExecStart=/bin/sh -c 'exec /root/openflux/openflux --role=exit --mode=l3 --negotiate --transports=direct:100,yandex:50 --direct-listen=0.0.0.0:8445 --encryption-key-file /root/openflux/etc/encryption-key --cookie-store /root/openflux/etc/cookies-yandex.json --url "$(cat /root/openflux/etc/document-url)"'
ExecStopPost=/bin/sh -c '/usr/sbin/iptables -C OUTPUT -p tcp --tcp-flags RST RST -j DROP 2>/dev/null && /usr/sbin/iptables -D OUTPUT -p tcp --tcp-flags RST RST -j DROP || true'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
# Binaries and backups: read-only. Config and state (key, document URL,
# cookie store): read-write, so the node can persist cookies and the files
# can be changed without touching the binaries.
ReadOnlyPaths=/root/openflux
ReadWritePaths=/root/openflux/etc

[Install]
WantedBy=multi-user.target
